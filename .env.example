# Copy to .env and fill in the key. Everything else has a sensible default.

ANTHROPIC_API_KEY=

# Models. Keep them here, not in code, so the bank's strings can be swapped in.
KYC_MODEL=claude-sonnet-4-6          # workflow and chat: newest Claude served from a single Vertex region
KYC_GUARD_MODEL=claude-haiku-5-5     # chat intent guardrail
KYC_EVAL_MODEL=claude-haiku-5-5      # evals and the live test
# KYC_MODEL_ALLOWLIST=claude-sonnet-4-6,claude-haiku-5-5   # what Helios will serve; defaults to the three above

# Helios simulation
# HELIOS_REGION=asia-southeast1
# HELIOS_MAX_RETRIES=2
# HELIOS_RETRY_BACKOFF=0.5
# HELIOS_CALLER_ID=kyc-workflow-harness

# Services (make up)
# VGB_PORT=8000
# VGB_API_KEY=vgb-demo-key
# MCP_PORT=8001
# MCP_URL=http://127.0.0.1:8001/mcp

# KYC_AUDIT_DIR=./audit
